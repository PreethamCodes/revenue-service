<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:r="urn:mahasetu:revenue:v1" targetNamespace="urn:mahasetu:revenue:v1" elementFormDefault="qualified">
  <xs:simpleType name="Status"><xs:restriction base="xs:string"><xs:enumeration value="VALID"/><xs:enumeration value="EXPIRED"/><xs:enumeration value="REVOKED"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Category"><xs:restriction base="xs:string"><xs:enumeration value="INCOME"/><xs:enumeration value="CASTE"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Student"><xs:restriction base="xs:string"><xs:pattern value="MHSTU[0-9]{4}"/></xs:restriction></xs:simpleType>
  <xs:element name="GetStudentCertificates"><xs:complexType><xs:sequence>
      <xs:element name="StudentID" type="r:Student"/>
      <xs:element name="CertificateType" type="r:Category" minOccurs="0"/>
      <xs:element name="RequestReference" type="xs:string"/>
  </xs:sequence></xs:complexType></xs:element>
  <xs:complexType name="Income"><xs:sequence>
      <xs:element name="ProviderRecordReference" type="xs:string"/>
      <xs:element name="CertificateStatus" type="r:Status"/>
      <xs:element name="IssueDate" type="xs:date"/>
      <xs:element name="ExpiryDate" type="xs:date"/>
      <xs:element name="AnnualIncomeINR" type="xs:decimal"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="Caste"><xs:sequence>
      <xs:element name="ProviderRecordReference" type="xs:string"/>
      <xs:element name="CertificateStatus" type="r:Status"/>
      <xs:element name="IssueDate" type="xs:date"/>
      <xs:element name="ExpiryDate" type="xs:date"/>
      <xs:element name="Category" type="xs:string"/>
  </xs:sequence></xs:complexType>
  <xs:element name="GetStudentCertificatesResponse"><xs:complexType><xs:sequence>
      <xs:element name="StudentID" type="r:Student"/>
      <xs:element name="RequestReference" type="xs:string"/>
      <xs:element name="IncomeCertificate" type="r:Income" minOccurs="0"/>
      <xs:element name="CasteCertificate" type="r:Caste" minOccurs="0"/>
  </xs:sequence></xs:complexType></xs:element>
  <xs:element name="ProviderFault"><xs:complexType><xs:sequence>
      <xs:element name="Code" type="xs:string"/>
      <xs:element name="Category" type="xs:string"/>
      <xs:element name="Message" type="xs:string"/>
      <xs:element name="RequestReference" type="xs:string"/>
      <xs:element name="ProviderReference" type="xs:string" minOccurs="0"/>
      <xs:element name="Retryable" type="xs:boolean"/>
      <xs:element name="Timestamp" type="xs:dateTime"/>
  </xs:sequence></xs:complexType></xs:element>
</xs:schema>
